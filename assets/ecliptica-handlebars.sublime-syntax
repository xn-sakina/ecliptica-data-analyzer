%YAML 1.2
---
name: Ecliptica Handlebars
file_extensions:
  - ecliptica-hbs
scope: text.template.ecliptica

contexts:
  main:
    - match: '\{\{!--'
      scope: punctuation.definition.comment.begin.handlebars
      push: block-comment
    - match: '\{\{!'
      scope: punctuation.definition.comment.begin.handlebars
      push: comment
    - match: '\{\{\{'
      scope: punctuation.section.embedded.begin.handlebars
      push: triple-expression
    - match: '\{\{'
      scope: punctuation.section.embedded.begin.handlebars
      push: expression

  block-comment:
    - meta_scope: comment.block.handlebars
    - match: '--\}\}'
      scope: punctuation.definition.comment.end.handlebars
      pop: true

  comment:
    - meta_scope: comment.block.handlebars
    - match: '\}\}'
      scope: punctuation.definition.comment.end.handlebars
      pop: true

  triple-expression:
    - meta_scope: meta.embedded.expression.handlebars
    - match: '\}\}\}'
      scope: punctuation.section.embedded.end.handlebars
      pop: true
    - include: expression-content

  expression:
    - meta_scope: meta.embedded.expression.handlebars
    - match: '\}\}'
      scope: punctuation.section.embedded.end.handlebars
      pop: true
    - include: expression-content

  expression-content:
    - match: '"'
      scope: punctuation.definition.string.begin.handlebars
      push: double-quoted-string
    - match: "'"
      scope: punctuation.definition.string.begin.handlebars
      push: single-quoted-string
    - match: '\b(?:true|false|null|undefined)\b'
      scope: constant.language.handlebars
    - match: '(?<![[:alnum:]_.])-?\b\d+(?:\.\d+)?\b'
      scope: constant.numeric.handlebars
    - match: '\b(?:if|unless|each|with|else)\b'
      scope: keyword.control.handlebars
    - match: '\b(?:random|cooldown_ready|lookup|log|eq|ne|gt|gte|lt|lte|and|or|not)\b'
      scope: support.function.handlebars
    - match: '[#/\^>|&~]'
      scope: keyword.operator.handlebars
    - match: '[()]'
      scope: punctuation.section.group.handlebars
    - match: '(?:@|\.\.?/)?[[:alpha:]_][[:alnum:]_.\-/]*'
      scope: variable.other.handlebars

  double-quoted-string:
    - meta_scope: string.quoted.double.handlebars
    - match: '\\.'
      scope: constant.character.escape.handlebars
    - match: '"'
      scope: punctuation.definition.string.end.handlebars
      pop: true

  single-quoted-string:
    - meta_scope: string.quoted.single.handlebars
    - match: '\\.'
      scope: constant.character.escape.handlebars
    - match: "'"
      scope: punctuation.definition.string.end.handlebars
      pop: true
